# Job Hunter — environment template
# Copy to .env and fill in. Never commit .env.

# ── LLM provider selection ─────────────────────────────────────
# One of: mlx | lmstudio | gemma | groq | gemini
LLM_PROVIDER=mlx

# ── Cloud providers (optional) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Local providers ───────────────────────────────────────────
# Ollama
OLLAMA_BASE=http://localhost:11434
GEMMA_MODEL=gemma2:latest

# MLX (native Apple Silicon) — HuggingFace ID or local path
MLX_MODEL=gemma-4-E4B-it-MLX-4bit
MLX_BASE_URL=http://localhost:1234/v1

# LM Studio server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-4-E4B-it-MLX-4bit

# Concurrent LLM workers for JD review (knee ~5-6 on M-series)
LLM_NUM_PARALLEL=6

# ── Database backend ──────────────────────────────────────────
# One of: supabase | local_pg | docker_pg | json
DB_BACKEND=json

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Local / Docker Postgres
DATABASE_URL=
